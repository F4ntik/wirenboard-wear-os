#!/bin/sh
set -eu

if [ "$1" = configure ]; then
    config=/etc/wb-wear-light-gateway.conf
    # dpkg preserves the obsolete 0.1 conffile. Seed a catalog only on fresh installs.
    if [ -z "${2:-}" ] && [ ! -e "$config" ]; then
        install -m 0644 /usr/share/wb-wear-light-gateway/wb-wear-light-gateway.conf "$config"
    fi
    state=/var/lib/wb-wear-light-gateway
    install -d -m 0700 -o root -g root "$state"
    if [ ! -s "$state/token.env" ]; then
        token_file=$(mktemp "$state/token.XXXXXXXX")
        trap 'rm -f "$token_file"' EXIT
        python3 -c 'import secrets; print("WB_GATEWAY_TOKEN=" + secrets.token_urlsafe(32))' > "$token_file"
        mv -fT "$token_file" "$state/token.env"
    fi
fi

#DEBHELPER#
