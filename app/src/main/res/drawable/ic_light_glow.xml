<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/ic_light_on">
    <target android:name="sunbeams">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="1250" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/fast_out_slow_in">
                <propertyValuesHolder android:propertyName="scaleX" android:valueFrom="0.88" android:valueTo="1.08" android:valueType="floatType" />
                <propertyValuesHolder android:propertyName="scaleY" android:valueFrom="0.88" android:valueTo="1.08" android:valueType="floatType" />
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
